{
  "name": "sytodos",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Block-native, high-performance todo management plugin for SiYuan Note",
  "license": "MIT",
  "author": "changshengyi",
  "keywords": [
    "siyuan",
    "todo",
    "task",
    "gtd"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "assets": "node ./scripts/make-assets.mjs",
    "check-package": "node ./scripts/check-package.mjs",
    "release": "npm run typecheck && npm run build && npm run check-package"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "fast-glob": "^3.3.3",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.86.0",
    "siyuan": "^1.2.9",
    "typescript": "~5.7.3",
    "vite": "^6.2.1",
    "vite-plugin-static-copy": "^2.3.0",
    "vite-plugin-zip-pack": "^1.0.5",
    "vue-tsc": "^2.2.0"
  }
}
